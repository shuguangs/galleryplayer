# ==============================================================
# 媒体播放器 .gitignore
# ==============================================================

# ---------- 隐私：用户数据（含真实路径/媒体目录缓存/缩略图） ----------
# 运行时自动生成，永远不要提交
userdata/
.userdata-stash/

# ---------- 隐私：AI 工具本地配置（settings.local.json 含本机用户名/路径） ----------
.claude/
.qoder/

# ---------- 构建产物 / 打包输出 ----------
build/
dist/
dist-fixed/
complete/
release/
*.zip

# ---------- 第三方二进制 ----------
# vendor/libmpv-2.dll 约 112 MB，超过 GitHub 单文件 100 MB 上限。
# 请按 README 指引自行下载放入 vendor/（见 README「从源码运行」一节）。
vendor/

# ---------- 本地开发截图（README 未引用，含真实界面） ----------
_*.png
_*.jpg

# ---------- 本地临时评测脚本 / 输出 ----------
_scenario_ab*.py
_ab_out.txt

# ---------- Python ----------
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.eggs/
.venv/
venv/
env/
.python-version

# ---------- IDE / 编辑器 ----------
.idea/
.vscode/
*.swp
*.swo

# ---------- 日志 / 系统文件 ----------
*.log
Thumbs.db
.DS_Store
desktop.ini

# AI 工具本地配置
.zcode/
.mimosa/
.skill-search-tmp/
.code_map_validation.json
GIT_COMMIT_INFO.md
# ---------- 私有翻译场景（仅本地，不上传） ----------
live-subtitle/scenarios/nsfw_gay.json
live-subtitle/scenarios/lingyu.json
CODE_MAP.md

# ---------- 本地临时测试脚本（含真实媒体路径，不上传） ----------
_thumb_bug_test/

# ---------- Spark 评测存档（模型+脚本+结果，本地保留，不提交） ----------
_spark_archive/

